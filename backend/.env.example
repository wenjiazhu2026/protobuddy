# ProtoBuddy 后端环境变量模板
# 复制为 .env（本地开发）；线上部署在 EdgeOne Makers 平台环境变量中设置。
# 未设置 OWNER_PASSWORD / OWNER_AUTH_SECRET 时 owner 认证 fail-closed（全部拒绝）。

# Owner 操作密码（必填，否则 owner 操作全部被拒绝）
OWNER_PASSWORD=change-me

# HMAC 签名密钥（必填，>=16 字符随机值，如 openssl rand -hex 32）
OWNER_AUTH_SECRET=change-me-to-a-random-hex-string

# --- 可选 ---
# CORS 允许的来源（逗号分隔；'*' 表示全部放开，仅限开发）
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JSON body 上限
# BODY_LIMIT=50mb

# 上传限制（单文件 MB / 文件数 / 总量 MB）
# UPLOAD_FILE_SIZE_MB=25
# UPLOAD_MAX_FILES=200
# UPLOAD_TOTAL_MB=150

# plan 生成限流（每窗口次数 / 窗口毫秒）
# PLAN_RATE_LIMIT=6
# PLAN_RATE_WINDOW_MS=600000

# EdgeOne 新建项目的加速区域：默认 overseas = 全球可用区（不含中国大陆），
# 绑定自定义域名无需 ICP 备案。已备案账号可改为 global（含中国大陆）。
# EDGEONE_AREA=overseas

# --- 仅测试用 ---
# Cloudflare API 基址覆盖。生产环境不要设置；端到端测试用它指向本地桩服务，
# 避免真实调用 Cloudflare。Cloudflare API Token 本身按项目存储，不走环境变量。
# CF_API_BASE=http://127.0.0.1:4599/client/v4
